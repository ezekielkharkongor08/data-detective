# Data Detective — environment configuration
# Copy this file to `.env` and adjust the values. NEVER commit `.env`.
#
# All model/LLM configuration lives here, not in code.

# LLM provider (currently: ollama)
LLM_PROVIDER=ollama

# Model name served by the provider
LLM_MODEL=llama3.1:8b

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Sampling temperature (0.0 = deterministic)
LLM_TEMPERATURE=0.0

# Optional max tokens (leave unset for provider default)
# LLM_MAX_TOKENS=2048

# PostgreSQL connection settings for M5 persistence (SQLAlchemy)
# Copy .env.example to .env and fill in your local values. NEVER commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user_name
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=data_detective

# Constructed SQLAlchemy URL (built from the components above).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://user_name:your_password_here@localhost:5432/data_detective
