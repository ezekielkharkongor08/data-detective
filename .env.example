# Data Detective — environment configuration
# Copy this file to `.env` and adjust the values. NEVER commit `.env`.
#
# All model/LLM configuration lives here, not in code.

# LLM provider (currently: ollama)
LLM_PROVIDER=ollama

# Model name served by the provider
LLM_MODEL=llama3.1:8b

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Sampling temperature (0.0 = deterministic)
LLM_TEMPERATURE=0.0

# Optional max tokens (leave unset for provider default)
# LLM_MAX_TOKENS=2048
