# Data Detective — environment configuration.
# Copy this file to .env and adjust the values. .env is never committed.

# --- LLM (Ollama) ---
llm_provider=ollama
llm_model=llama3.1:8b
ollama_base_url=http://localhost:11434
llm_temperature=0.0
# llm_max_tokens=

# --- Database ---
# Leave DATABASE_URL unset (or empty) to use the local SQLite backend at
# database_path. Set it to a PostgreSQL connection string to use Postgres.
# database_url=
database_path=./data_detective.db

# --- PostgreSQL (only used when DATABASE_URL points at a Postgres server) ---
postgres_host=localhost
postgres_port=5432
postgres_user=postgres
postgres_password=changeme
postgres_db=data_detective

# --- Docker Compose Postgres profile ---
# When using `docker compose --profile postgres`, set DATABASE_URL to connect
# to the compose `db` service (no spaces):
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=data_detective

# --- Observability (LangSmith) ---
# Set to true and provide your LangSmith API key to trace agent runs,
# check latency, token usage, and graph branching in LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=data-detective
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
